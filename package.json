{
  "name": "@b12k/the-boilerplate-vue",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Bogdan Kolesnyk",
  "repository": "https://github.com/b12k/the-boilerplate-vue",
  "type": "module",
  "scripts": {
    "build": "pnpm clean && run-p build:*",
    "build:client": "pnpm rspack build --configLoader=jiti -c rspack/config.single.ts",
    "build:public": "swc ./src/public -d ./dist --copy-files --strip-leading-paths --config-file public.swcrc",
    "build:server": "swc ./src/server -d ./dist --copy-files --strip-leading-paths --config-file ./server.swcrc",
    "check": "run-p -ln check:*",
    "check:format": "pnpm ~oxfmt --check .",
    "check:scripts": "pnpm exec oxlint .",
    "check:styles": "pnpm ~stylelint \"**/*.{css,scss,vue}\"",
    "check:types": "pnpm ~tsc",
    "clean": "shx rm -rf dist",
    "deploy": "env-cmd -i curl -X POST {{PORTAINER_WEBHOOK}}",
    "deps:check": "ncu -e 1",
    "deps:update": "ncu -du --doctorInstall \"pnpm i\" --doctorTest \"pnpm deps:update:doctor\"",
    "deps:update:doctor": "run-p check:types check:styles check:scripts build",
    "dev": "run-p dev:*",
    "dev:client": "run-p -ln dev:client:*",
    "dev:client:browser": "env-cmd pnpm rspack serve --configLoader=jiti -c rspack/config.browser.ts",
    "dev:client:server": "env-cmd pnpm rspack build --configLoader=jiti -c rspack/config.server.ts",
    "dev:docker-compose": "docker compose up -d",
    "dev:public": "pnpm build:public --watch",
    "dev:server": "run-s -ln dev:server:wait dev:server:run",
    "dev:server:run": "nodemon",
    "dev:server:wait": "env-cmd -i wait-on http://localhost:{{WDS_PORT}}/public/manifest.json",
    "docker:build:amd": "env-cmd -i pnpm ~docker-build --cache-from={{DOCKER_IMAGE}}-amd64-latest -t {{DOCKER_IMAGE}}-amd64-latest",
    "docker:build:arm": "env-cmd -i pnpm ~docker-build --cache-from={{DOCKER_IMAGE}}-arm64-latest -t {{DOCKER_IMAGE}}-arm64-latest --platform linux/arm64",
    "docker:down": "docker compose down",
    "fix": "run-p -ln fix:*",
    "fix:format": "pnpm ~oxfmt --write .",
    "fix:scripts": "pnpm check:scripts --fix",
    "fix:styles": "pnpm check:styles --fix",
    "husky:commit-msg": "commitlint",
    "husky:pre-commit": "lint-staged && pnpm ~tsc",
    "husky:pre-push": "branch-name-lint",
    "prepare": "run-p prepare:*",
    "prepare:env": "shx cp -u .env.example .env",
    "prepare:husky": "husky",
    "start": "node dist/server/server.js",
    "start:local": "nodemon --watch src --watch .env --ext * --exec \"pnpm build && cross-env NODE_ENV=production env-cmd -n node ./dist/server/server.js\"",
    "stats": "cross-env IS_STATS_ENABLED=true NODE_ENV=production pnpm build && serve ./dist/bundle-stats.html",
    "~docker-build": "cross-env DOCKER_BUILDKIT=1 docker buildx build . --build-arg BUILDKIT_INLINE_CACHE=1 --push",
    "~oxfmt": "oxfmt --no-error-on-unmatched-pattern",
    "~stylelint": "stylelint --ignore-path=.gitignore",
    "~tsc": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@b12k/vue3-router-gmc": "0.1.3",
    "@nitedani/shrink-ray-current": "4.3.0",
    "@unhead/vue": "3.4.1",
    "animate.css": "4.1.1",
    "axios": "1.20.0",
    "cookie-parser": "1.4.7",
    "decache": "4.6.2",
    "deep-object-diff": "1.1.9",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "js-cookie": "3.0.8",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "nunjucks": "3.2.4",
    "path-to-regexp": "8.4.2",
    "pinia": "4.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "purgecss": "8.0.0",
    "redis": "6.2.1",
    "safe-stable-stringify": "2.5.0",
    "serve-favicon": "2.5.1",
    "surenv": "1.1.0",
    "ua-parser-js": "2.0.10",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@b12k/branch-name-lint": "1.3.0",
    "@b12k/env-cmd": "10.2.0",
    "@commitlint/config-conventional": "21.2.3",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@rspack/dev-server": "2.2.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bootstrap": "5.2.11",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-pino-logger": "4.0.6",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.3",
    "@types/nunjucks": "3.2.6",
    "@types/serve-favicon": "2.5.7",
    "@types/ua-parser-js": "0.7.39",
    "@types/webpack-env": "1.18.8",
    "@vue/language-server": "3.3.11",
    "autoprefixer": "10.6.1",
    "bundle-stats-webpack-plugin": "4.22.3",
    "chokidar": "5.0.0",
    "commitlint": "21.2.3",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "eslint-plugin-perfectionist": "5.12.1",
    "husky": "9.1.7",
    "ignore-loader": "0.1.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "npm-check-updates": "23.1.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.28",
    "postcss-html": "2.0.0",
    "postcss-loader": "8.2.1",
    "rspack-manifest-plugin": "5.2.2",
    "serve": "14.2.6",
    "shx": "0.4.0",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-loader": "17.4.2",
    "vue-style-loader": "4.1.3",
    "vue-tsc": "3.3.11",
    "wait-on": "9.4.0"
  },
  "packageManager": "pnpm@12.6.0"
}
