{
  "$schema": "https://swc.rs/schema.json",
  "module": {
    "type": "es6",
    "resolveFully": true
  },
  "jsc": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/client/*"
      ],
      "@server/*": [
        "./src/server/*"
      ]
    },
    "parser": {
      "syntax": "typescript"
    },
    "target": "esnext",
    "externalHelpers": false
  }
}
