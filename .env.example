###### Local setup ######
ACCEPTED_LANGUAGES=de,en
API_URL=http://localhost:8080/api/mocks
DEFAULT_LANGUAGE=en
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PASSWORD=secret
REDIS_PORT=6379
WDS_PORT=8081

###### Server overrides ######
# Defaults: src/server/env/env-defaults.ts
# PORT=8080
# CACHE_CRITICAL_CSS=false
# CACHE_CRITICAL_CSS_BUDGET_MS=10000
# CACHE_CRITICAL_CSS_TTL_SEC=60
# CACHE_RENDER=false
# CACHE_RENDER_TTL_SEC=60
# DEBUG=true
# DEBUG_ON_KEY=9ed6b10e-44b5-41c7-bbd7-9f54c501ea0d
# LIVE_RELOAD_PATH=__live-reload
# LOG_LEVEL=debug
# REDIS_CONNECTION_RETRIES=5
# REDIS_READ_TIMEOUT_MS=1000
# SERVE_SOURCE_MAPS=true
# SSR_RESPONSE_BUDGET_MS=30000

###### Build overrides ######
# BUNDLER_CACHE=true
# DOCKER_IMAGE=b12k:the-boilerplate-vue
# STATS_ENABLED=true
