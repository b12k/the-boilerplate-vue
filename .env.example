###### Required ######
ACCEPTED_LANGUAGES=de,en
DEFAULT_LANGUAGE=en
NODE_ENV=development
PORT=8080

###### Optional ######
CACHE_CRITICAL_CSS=true
CACHE_CRITICAL_CSS_BUDGET_SEC=10
CACHE_CRITICAL_CSS_SALT=123123
CACHE_CRITICAL_CSS_TTL_SEC=60
CACHE_RENDER=true
CACHE_RENDER_SALT=123123
CACHE_RENDER_TTL_SEC=60
# DEBUG=true
# DEBUG_ON_KEY=super-secret-key
LIVE_RELOAD_PATH=__live-reload
LOG_LEVEL=info
REDIS_URL=redis://default:secret@localhost:6379
SERVE_SOURCE_MAPS=false

###### Development ######
BUNDLER_CACHE=true
DOCKER_IMAGE=b12k:the-boilerplate-vue
REDIS_PASSWORD=secret
REDIS_PORT=6379
STATS_ENABLED=false
WDS_PORT=8081
