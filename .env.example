###### Local setup ######
ACCEPTED_LANGUAGES=de,en
API_URL=http://localhost:8080/api/mocks
DEFAULT_LANGUAGE=en
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PASSWORD=secret
REDIS_PORT=6379
WDS_PORT=8081

###### Server defaults and overrides ######
# Defaults: src/server/env/env-defaults.ts
# Uncomment and edit to override a default.
# NODE_ENV=production
# PORT=8080
# CACHE_CRITICAL_CSS=true
# CACHE_CRITICAL_CSS_BUDGET_MS=10000
# CACHE_CRITICAL_CSS_MAX_HTML_BYTES=1048576
# CACHE_CRITICAL_CSS_MAX_QUEUE=8
# CACHE_CRITICAL_CSS_MAX_THREADS=1
# CACHE_CRITICAL_CSS_TTL_SEC=86400
# CACHE_RENDER=true
# CACHE_RENDER_TTL_SEC=86400
# DEBUG_ON_KEY: no default; omit to disable production diagnostics.
# LIVE_RELOAD_PATH: no default; set only when live reload is enabled.
# LOG_LEVEL=info
# REDACT_LOGS=true
# REDIS_CONNECTION_RETRIES=5
# REDIS_READ_TIMEOUT_MS=1000
# SERVE_SOURCE_MAPS=false
# SHUTDOWN_BUDGET_MS=30000
# SSR_RESPONSE_BUDGET_MS=30000

###### Build defaults and overrides ######
# BUNDLER_CACHE=false
# DOCKER_IMAGE: no default; set your image name before docker:build.
# STATS_ENABLED=false
