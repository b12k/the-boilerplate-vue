<script nonce="{{ nonce }}">
    const liveReloadUrl = "/{{ env.LIVE_RELOAD_PATH }}";
    const retryDelayMs = 300;
    const maxConnectionAttempts = 10;
    let isServerUp = true;
    (function connect(attemptIndex) {
      if (attemptIndex >= maxConnectionAttempts) return;

      const liveReloadEventSource = new EventSource(liveReloadUrl);

      liveReloadEventSource.onmessage = function () {
        if (isServerUp) return;
        window.location.reload();
      }

      liveReloadEventSource.onerror = function () {
        liveReloadEventSource.close();
        isServerUp = false;
        setTimeout(() => {
          connect(attemptIndex + 1);
        }, retryDelayMs);
      }
    })(0);
</script>
