<html>
  <head>
    <script nonce="{{ nonce }}">
      const notFoundPageUrl = [
        window.location.origin,
        '{{ lang }}',
        '404',
      ].join('/');
      const pathname = window.location.pathname;
      window.location.href = `${notFoundPageUrl}?url=${encodeURIComponent(pathname)}`;
    </script>
    <style>
      body {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100vw;
        height: 100vh;
        font-family: sans-serif;
        font-size: 5vw;
        font-weight: bolder;
        display: flex;
        overflow: hidden;
      }
    </style>
  </head>
  <body>404 🤔</body>
</html>
