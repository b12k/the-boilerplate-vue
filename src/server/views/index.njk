<!DOCTYPE html>
<html{{ head.htmlAttrs | safe }}>
  <head>
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    {{ head.headTags | safe }}
    {% if criticalCss %}
      <style data-type="critical-css">{{ criticalCss | safe }}</style>
      {% for style in pageAssets.css %}<link rel="preload" as="style" href="{{ style }}" data-async-css>{% endfor %}
    {% else %}
      {% for style in pageAssets.css %}<link rel="stylesheet" href="{{ style }}">{% endfor %}
    {% endif %}
    {% for script in pageAssets.js %}<script src="{{ script }}" defer></script>{% endfor %}
    <noscript>
      {% for style in pageAssets.css %}<link rel="stylesheet" href="{{ style }}">{% endfor %}
    </noscript>
    <script defer
            src="https://cloud.umami.is/script.js"
            data-website-id="127e8d85-f677-4920-84fd-9e6e58f8aeaa"></script>
  </head>
  <body {{ head.bodyAttrs | safe }}>
    {{ head.bodyTagsOpen | safe }}
    <div id="app">{{ html | safe }}</div>
    {{ head.bodyTags | safe }}
    {% if context.isDebug %}
      {% include "_env.njk" %}
    {% endif %}
    <script nonce="{{ nonce }}">
      window.INITIAL_STATE = {{ state | safe }};
      document.querySelectorAll('[data-async-css]').forEach((link) => {
        link.rel = 'stylesheet';
      });
    </script>
  </body>
  {% if not env.IS_PROD and env.LIVE_RELOAD_PATH %}
    {% include "_live-reload.njk" %}
  {% endif %}
</html>
