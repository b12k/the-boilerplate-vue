<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>DEBUG</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/jquery.json-viewer@1.5.0/json-viewer/jquery.json-viewer.min.css">
    <script nonce="{{ nonce }}" src="https://cdn.jsdelivr.net/npm/jquery@3.6.1/dist/jquery.min.js"></script>
    <script nonce="{{ nonce }}" src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"></script>
    <script nonce="{{ nonce }}" src="https://cdn.jsdelivr.net/npm/jquery.json-viewer@1.5.0/json-viewer/jquery.json-viewer.min.js"></script>
    <style>
      a.json-toggle::before {
        line-height: 1.5;
      }

      .json-string {
        word-break: break-all;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="text-center">💥</h1>
      <h3 class="text-center">{{ message }}</h3>
      <section id="details" class="bg-light border border-secondary rounded">
      </section>
    </div>
    <script nonce="{{ nonce }}">
      $('#details').jsonViewer({{ details | safe }}, {
        collapsed: true,
        withLinks: true,
        rootCollapsable: false,
      });
    </script>
  </body>
</html>
